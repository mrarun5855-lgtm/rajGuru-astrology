# Base URL used in metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.guruastrology.in

# --- Talk to Astrologer / leads admin page ---
# Password required to view submitted consultation leads at
# /leads (query string: ?key=YOUR_KEY).
# Change this to something private before deploying!
ADMIN_KEY=changeme

# --- Optional: email notification for each new lead ---
# If all four of these are set, /api/leads will also email each new
# consultation request (useful because on serverless hosts the leads.json
# file below does not reliably persist — see app/api/leads/route.js).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEADS_NOTIFY_EMAIL=dobrabhatt@gmail.com
