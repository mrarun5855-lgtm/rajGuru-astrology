# Base URL used in metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.guruastrology.in

# --- Firebase Firestore (leads storage) ---
# Required for form submissions (Register / Talk to Astrologer / Contact)
# to be saved and shown on /leads. Without this, submissions still succeed
# for the user but are not stored anywhere (unless SMTP is also set below).
#
# How to get this value: Firebase Console → Project Settings (gear icon) →
# Service Accounts tab → "Generate new private key" → downloads a JSON
# file. Minify it to one line and paste the whole thing here as a single
# value (see README.md for the exact command). Example shape (values
# shortened):
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"guru-astrology","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@guru-astrology.iam.gserviceaccount.com", ...}
