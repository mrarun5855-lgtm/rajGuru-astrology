# --- Talk to Astrologer / leads admin page ---
# Password required to view submitted leads at /leads (query string:
# ?key=YOUR_KEY). Change this to something private before deploying!
ADMIN_KEY=changeme

# --- Optional: email notification for each new lead ---
# If all four of these are set, /api/leads will also email each new
# submission — a nice-to-have alongside Firestore, not a replacement for it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEADS_NOTIFY_EMAIL=dobrabhatt@gmail.com
